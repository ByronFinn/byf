{
  "name": "@byfriends/vis-server",
  "version": "0.5.0",
  "description": "DEPRECATED — session visualizer server, replaced by @byfriends/web-server (PRD-0035 unified workbench); kept as a compatibility shim for one minor version",
  "keywords": [
    "byf",
    "debugging",
    "deprecated",
    "server",
    "vis"
  ],
  "homepage": "https://github.com/ByronFinn/byf",
  "bugs": {
    "url": "https://github.com/ByronFinn/byf/issues"
  },
  "license": "MIT",
  "author": "ByronFinn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByronFinn/byf.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.mts",
      "default": "./src/server.ts",
      "bun": "./src/server.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/server.d.mts",
        "import": "./dist/server.mjs",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun ../../../build/bun-lib-build.mjs ./src/server.ts ./src/index.ts --bundle-workspace --target bun && bun scripts/build-dts.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@byfriends/web-server": "workspace:^"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
