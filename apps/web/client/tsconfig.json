{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist-types",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": ["src", "../../../packages/agent-core/src/prompt-modules.d.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../../../packages/node-sdk" }]
}
