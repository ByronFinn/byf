{
  "name": "@byfriends/web-client",
  "version": "0.1.0",
  "private": true,
  "description": "Browser SPA for the BYF web client",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.74.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.5.2",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@byfriends/agent-core": "workspace:*",
    "@byfriends/kosong": "workspace:*",
    "@byfriends/sdk": "workspace:*",
    "@byfriends/web-shared": "workspace:*",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "6.0.2",
    "vite": "^6.3.3"
  }
}
